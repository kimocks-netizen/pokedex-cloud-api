{
  "name": "pokedex-cloud-api",
  "version": "1.0.0",
  "description": "Serverless Pokemon API with AWS Lambda, API Gateway, and PostgreSQL",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "npm test -- __tests__/unit",
    "test:integration": "npm test -- __tests__/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.mjs",
    "deploy": "sam build && sam deploy",
    "deploy:dev": "sam build && sam deploy --config-env dev",
    "deploy:prod": "sam build && sam deploy --config-env prod",
    "local:start": "sam local start-api --env-vars env.json",
    "local:invoke": "sam local invoke",
    "seed": "node scripts/seed-database.mjs",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "keywords": ["pokemon", "serverless", "aws", "lambda", "api-gateway", "postgresql"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.22.0"
  }
}
